+    /// <returns>False if the value is already indexed.</returns>
+    public bool Add(Rectangle2D<TCoordinate> bounds, T item)
+    {
+        ArgumentNullException.ThrowIfNull(item);
+        _lock.EnterWriteLock();
+        try
