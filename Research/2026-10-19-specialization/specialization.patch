+    public void ReplaceAll(IReadOnlyList<SpatialEntry3D<TCoordinate, T>> items)
+    {
+        ArgumentNullException.ThrowIfNull(items);
+        lock (_writer)
+        {
+            RTree3D<TCoordinate, T> next = new(_maxEntries);
+            next.BulkLoad(items, _workspace);
+            Volatile.Write(ref _current, next);
+        }
+    }
+
+    /// <summary>Appends intersecting items from one published version to <paramref name="results"/>.</summary>
